# Copy this file to .env (never commit .env) and fill in your Cloudinary keys.
# They're on the Cloudinary dashboard under Settings > API Keys.
# Only needed on your computer when running `npm run photos` / `npm run build`;
# Render doesn't need them.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The Cloudinary folder to put photos in
CLOUDINARY_FOLDER=dustinevansdotnet
